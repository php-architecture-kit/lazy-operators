{
    "name": "php-architecture-kit/lazy-operators",
    "description": "Lazy, composable expression operators (arithmetic, comparison, logical, conditional) for building deferred data-transformation flows in PHP.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Patryk Baszak",
            "email": "patryk.baszak@gmail.com",
            "homepage": "https://patrykbaszak.com/"
        }
    ],
    "keywords": ["lazy-operators", "expressions", "framework-agnostic"],
    "homepage": "https://github.com/php-architecture-kit/lazy-operators",
    "support": {
        "issues": "https://github.com/php-architecture-kit/lazy-operators/issues",
        "source": "https://github.com/php-architecture-kit/lazy-operators"
    },
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "*",
        "friendsofphp/php-cs-fixer": "*"
    },
    "autoload": {
        "psr-4": {
            "PhpArchitecture\\LazyOperators\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpArchitecture\\LazyOperators\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "bin/phpunit",
        "test:coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "@test --do-not-cache-result --coverage-cobertura var/coverage/phpunit-coverage.xml"
        ],
        "code:fix": "vendor/bin/php-cs-fixer --config=tools/php-cs-fixer/php-cs-fixer.php fix",
        "code:fix:dry": "vendor/bin/php-cs-fixer --config=tools/php-cs-fixer/php-cs-fixer.php check --diff",
        "code:analyse": "vendor/bin/phpstan analyse src -c tools/phpstan/phpstan.neon",
        "code:analyse:b": "vendor/bin/phpstan analyse src -c tools/phpstan/phpstan.neon --generate-baseline tools/phpstan/baseline.neon --allow-empty-baseline"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
